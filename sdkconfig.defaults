# Target: MH-ET LIVE ESP32 MiniKit (ESP32-WROOM-32, 4MB flash)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Size optimisation (Matter is large)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# BLE for commissioning (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=70
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y


# lwIP / IPv6 required by Matter
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_MAX_SOCKETS=10

# mbedTLS
CONFIG_MBEDTLS_HKDF_C=y

# Disable Thread (ESP32 has no 802.15.4) - Wi-Fi only
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_ENABLE_WIFI_STATION=y

# Serial console with "matter" commands (wifi, factoryreset, onboardingcodes...)
CONFIG_ENABLE_CHIP_SHELL=y

# Avoid USB-JTAG console on classic ESP32
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Vendor / product name overrides (main/CHIPProjectConfig.h)
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"

# Open BLE commissioning window at boot when no fabric is provisioned; close after 15 min
CONFIG_CHIP_ENABLE_PAIRING_AUTOSTART=y
CONFIG_CHIP_DISCOVERY_TIMEOUT_SECS=900
